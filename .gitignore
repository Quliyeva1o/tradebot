# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Project local files
logs/
*.log
data/**/*.csv
data/**/*.sqlite
artifacts/diagnostics_results.json
risk/*.flag
risk/daily_risk_state.json
execution/paper_broker_state.json

# IDEs & System files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Paper-mode isolated runtime state (mirrors risk/daily_risk_state.json above)
risk/daily_risk_state_paper.json
risk/daily_risk_state_midnight_fvg_paper.json
risk/midnight_fvg_daily_resolved.json
risk/midnight_fvg_daily_resolved_paper.json
risk/daily_risk_state_sr_bias_*_paper.json
risk/daily_risk_state_first_fvg_15m_paper.json
risk/first_fvg_15m_daily_resolved.json
risk/first_fvg_15m_daily_resolved_paper.json
risk/daily_risk_state_xauusd_orb_*_paper.json
risk/daily_risk_state_nasdaq_orb_*_paper.json
# msvcrt lock handles created by execution/paper_broker.py's _StateFileLock:
# always 0 bytes, recreated on demand, and five of them were tracked by
# accident -- a checked-out lock file serves no purpose.
risk/*.json.lock
# Paper-broker virtual balances and OPEN POSITIONS. Per-machine runtime
# state, exactly like daily_risk_state above -- but these four were
# tracked by accident, so the 2026-09-10 VPS migration inherited the
# workstation's open NDX100 paper position through git clone and closed
# it on the new box while the old one still held it. A clone must start
# with an empty paper account, not somebody else's trades.
risk/paper_broker_state_*.json

# Superseded backtest outputs, archived locally on 2026-08-27 (see
# SESSION_HANDOFF.md). Kept out of git deliberately: they were produced
# before the lookahead/same-bar fixes and are actively misleading. Their
# original committed versions remain retrievable from git history.
artifacts/old/

# Claude Code local (machine-specific) permission overrides
.claude/settings.local.json
